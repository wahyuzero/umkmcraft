# UMKM Craft — environment (salin ke .env.local)

# Google Gemini (opsional — tanpa key, engine deterministik/template jalan penuh)
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Pemilihan model (jangan hardcode — model generational itu perishable, §7.1)
AI_MODEL_PRIMARY=gemini-2.5-flash-lite
AI_MODEL_FALLBACK=gemini-2.5-flash

# Domain tenant untuk subdomain (dev: lvh.me mengarah ke 127.0.0.1)
NEXT_PUBLIC_TENANT_DOMAIN=lvh.me

# Penyimpanan MVP (file-backed store)
# UMKMCRAFT_DATA_DIR=./.data

# Produksi (Fase 4): Postgres + Prisma 7
# DATABASE_URL=postgres://...
